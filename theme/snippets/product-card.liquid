{%- comment -%}
  Product card. Structure and interactions adapted from the Codrops "Responsive Product Grid Layout" (MIT):
  a photo tile that flips in 3D to a second photo, an options bar (favourite, option pop-overs, quick add) and a title/price row.
  Usage: render 'product-card', product: product, index: forloop.index0, eager: 2.
  Hooks other scripts rely on: .cell (data-price/title/new for sorting), .card (scroll reveal), .t (search highlight), [data-quick].
{%- endcomment -%}
{%- assign lead = product.featured_image -%}
{%- if lead.alt contains 'Safe use' and product.images.size > 1 -%}{%- assign lead = product.images[1] -%}{%- endif -%}
{%- assign has_back = false -%}
{%- for img in product.images limit: 4 -%}
  {%- if has_back == false and img.id != lead.id -%}{%- assign back = img -%}{%- assign has_back = true -%}{%- endif -%}
{%- endfor -%}
{%- assign card_index = index | default: 99 -%}
{%- assign eager_n = eager | default: 0 -%}
{%- if card_index < eager_n -%}{%- assign card_loading = 'eager' -%}{%- else -%}{%- assign card_loading = 'lazy' -%}{%- endif -%}
{%- assign pk = card_index | modulo: 6 | plus: 1 -%}
<div class="cell pg-cell" data-handle="{{ product.handle }}" data-price="{{ product.price }}" data-title="{{ product.title | escape }}" data-new="{{ product.published_at | date: '%s' }}">
  <article class="card pg" style="--i: {{ index | default: 0 | at_most: 14 }}; --pc: var(--p{{ pk }})">
    <div class="pg-stage">
      {%- if has_back -%}
        <button type="button" class="pg-rotate" data-pg-rotate aria-pressed="false" aria-label="Show the other photo: {{ product.title | escape }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
        </button>
      {%- endif -%}
      {% render 'offer-flag', product: product, mode: 'badge' %}
      <a class="pg-item" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
        <span class="pg-flip">
          <span class="pg-face pg-front">
            {%- if lead -%}{{ lead | image_url: width: 700 | image_tag: loading: card_loading, widths: '300, 500, 700', sizes: '(min-width: 1100px) 24vw, (min-width: 760px) 32vw, 46vw', alt: '' }}{%- endif -%}
          </span>
          {%- if has_back -%}
            <span class="pg-face pg-back">{{ back | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 1100px) 24vw, (min-width: 760px) 32vw, 46vw', alt: '' }}</span>
          {%- endif -%}
        </span>
      </a>
    </div>

    <ul class="pg-opts" aria-label="{{ product.title | escape }}">
      <li>
        <button type="button" class="pg-opt pg-fav" data-fav="{{ product.handle }}" aria-pressed="false" aria-label="Save to favourites: {{ product.title | escape }}">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3 5.5 6.2 5.5c2 0 3.4 1.1 5.8 3.5 2.4-2.4 3.8-3.5 5.8-3.5 3.2 0 5 3.1 3.7 6.3C19.5 16.4 12 21 12 21z"/></svg>
        </button>
      </li>
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values limit: 2 -%}
          {%- if option.values.size > 1 -%}
          <li class="pg-optcell">
            <button type="button" class="pg-opt" data-pg-opt data-opt-name="{{ option.name | escape }}" aria-expanded="false" aria-label="{{ option.name | escape }}: {{ option.values.size }}">
              <span>{{ option.name | split: ' ' | first | truncate: 10, '' }}</span><sup>{{ option.values.size }}</sup>
            </button>
            <div class="pg-tip" role="group" aria-label="{{ option.name | escape }}">
              {%- assign is_size = false -%}
              {%- assign oname = option.name | downcase -%}
              {%- if oname contains 'size' -%}{%- assign is_size = true -%}{%- endif -%}
              {%- for value in option.values limit: 8 -%}
                {%- assign label = value -%}
                {%- if is_size -%}
                  {%- assign vkey = value | downcase | strip -%}
                  {%- case vkey -%}
                    {%- when 'extra small', 'x-small', 'xsmall' -%}{%- assign label = 'XS' -%}
                    {%- when 'small' -%}{%- assign label = 'S' -%}
                    {%- when 'medium' -%}{%- assign label = 'M' -%}
                    {%- when 'large' -%}{%- assign label = 'L' -%}
                    {%- when 'extra large', 'x-large', 'xlarge' -%}{%- assign label = 'XL' -%}
                    {%- when 'extra extra large', 'xx-large', 'xxlarge' -%}{%- assign label = 'XXL' -%}
                  {%- endcase -%}
                {%- endif -%}
                <button type="button" class="{% if is_size %}pg-size{% endif %}" data-quick="{{ product.handle }}" title="{{ value | escape }}" aria-label="{{ option.name | escape }}: {{ value | escape }}">{{ label }}</button>
              {%- endfor -%}
              {%- if option.values.size > 8 -%}
                <button type="button" class="pg-more" data-quick="{{ product.handle }}">+{{ option.values.size | minus: 8 }} more</button>
              {%- endif -%}
            </div>
          </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}
      <li>
        {%- if product.available -%}
          <button type="button" class="pg-opt pg-add" data-quick="{{ product.handle }}" aria-label="{{ 'general.quick_view' | t }}: {{ product.title | escape }}">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z"/><path d="M9 8V6.5A3 3 0 0 1 12 3.5a3 3 0 0 1 3 3V8"/></svg>
          </button>
        {%- else -%}
          <span class="pg-opt pg-soldout">{{ 'general.sold_out' | t }}</span>
        {%- endif -%}
      </li>
    </ul>

    <div class="pg-info">
      <a class="t" href="{{ product.url }}">{{ product.title }}</a>
      <span class="p">{% render 'price', product: product %}</span>
      {% render 'rating-stars', product: product %}
    </div>
  </article>
</div>
