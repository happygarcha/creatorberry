{% render 'breadcrumbs' %}
<header class="page-head dw-coll-head">
  <h1>{{ collection.title }}</h1>
  <div class="dw-coll-tools">
    <form class="dw-coll-search" role="search" action="{{ routes.search_url }}" method="get">
      <label class="sr-only" for="coll-q">Search in {{ collection.title | escape }}</label>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input id="coll-q" type="search" name="q" placeholder="Search in {{ collection.title | escape }}" autocomplete="off" data-coll-search>
      <input type="hidden" name="type" value="product">
    </form>
    <form class="sortbar" method="get" action="{{ collection.url }}">
      <label class="sr-only" for="sort_by">{{ 'collection.sort' | t }}</label>
      <select id="sort_by" name="sort_by" data-coll-sort>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
      <noscript><button class="btn" type="submit">{{ 'collection.sort' | t }}</button></noscript>
    </form>
  </div>
</header>

{%- comment -%}
  Filter chips: when this category has sub-categories in the main menu (for example Bathroom: Shower Curtains and Bath Mats),
  the page shows all of its products with chips that filter them on the page. Seasonal is one list, so it gets no chips.
{%- endcomment -%}
{%- assign has_menu_chips = false -%}
{%- for link in linklists['main-menu'].links -%}
  {%- if link.object.handle == collection.handle and link.links.size > 0 and collection.handle != 'seasonal' -%}
    {%- assign has_menu_chips = true -%}
    <div class="dw-subchips" role="group" aria-label="Filter {{ collection.title | escape }}" data-sub-chips data-more-label="{{ section.settings.more_label | default: 'More' | escape }}" data-more-groups="{{ section.settings.more_groups | escape }}">
      <button type="button" class="dw-subchip is-on" data-sub="" aria-pressed="true">All</button>
      {%- for child in link.links -%}
        {%- if child.object.handle != blank -%}<button type="button" class="dw-subchip" data-sub="{{ child.object.handle }}" aria-pressed="false">{{ child.title }}</button>{%- endif -%}
      {%- endfor -%}
    </div>
    <script type="application/json" data-coll-subs>{
      {%- assign first_sub = true -%}
      {%- for child in link.links -%}
        {%- if child.object.handle != blank -%}
          {%- unless first_sub -%},{%- endunless -%}{%- assign first_sub = false -%}
          "{{ child.object.handle }}": [{% for p in child.object.products limit: 50 %}"{{ p.handle }}"{% unless forloop.last %},{% endunless %}{% endfor %}]
        {%- endif -%}
      {%- endfor -%}
    }</script>
  {%- endif -%}
{%- endfor -%}
{%- comment -%}
  Categories without sub-collections get chips from keyword groups written in the section settings ("Category chips by keyword").
  A category only gets chips when its handle appears in that text as a heading, for example [kitchen].
{%- endcomment -%}
{%- assign kw_tag = '[' | append: collection.handle | append: ']' -%}
{%- if has_menu_chips == false and section.settings.kw_groups contains kw_tag -%}
  <div class="dw-subchips dw-kwchips" role="group" aria-label="Filter {{ collection.title | escape }}" data-sub-chips data-kw-handle="{{ collection.handle }}" data-kw-min="{{ section.settings.kw_min }}" data-kw-groups="{{ section.settings.kw_groups | escape }}">
    <button type="button" class="dw-subchip is-on" data-sub="" aria-pressed="true">All</button>
  </div>
{%- endif -%}

{%- paginate collection.products by section.settings.per_page -%}
  {%- if collection.products.size == 0 -%}
    <p class="empty-state">{{ 'collection.empty' | t }}</p>
  {%- else -%}
    <p class="dw-coll-none" data-coll-none hidden>No products here match <b data-coll-term></b>. <a data-coll-site href="{{ routes.search_url }}">Search the whole store instead</a></p>
    <div class="feed">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product, index: forloop.index0, eager: 2 %}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if paginate.pages > 1 -%}
    <nav class="pager" aria-label="{{ 'general.pagination' | t }}">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="cur" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
    </nav>
  {%- endif -%}
{%- endpaginate -%}

{%- comment -%} The category description sits below the products, so shoppers see products first. Search engines still read it. {%- endcomment -%}
{%- if collection.description != blank -%}
  <section class="dw-coll-about" aria-label="About {{ collection.title | escape }}"><div class="prose">{{ collection.description }}</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "default": 48, "label": "Products per page" },
    { "type": "text", "id": "more_label", "label": "Chip that opens the extra categories", "default": "More", "info": "Shown on categories that have sub-categories, for example Bathroom. Tapping it opens a second row of chips." },
    { "type": "range", "id": "kw_min", "min": 6, "max": 40, "step": 1, "default": 16, "label": "Minimum products for keyword chips", "info": "Chips show only when a category has at least this many live products. Drafts do not count." },
    { "type": "textarea", "id": "kw_groups", "label": "Category chips by keyword", "default": "[kitchen]\nMats & rugs: floor mat, door mat, doormat, drying mat, draining mat, rug, runner\nAprons & linens: apron, glove, mitt, curtain, trivet\nStorage: storage, rack, turntable, organiser, organizer, food cover, lids\nBar & dining: porcelain, plate, shot glass, barware, wine, ice ball\nBaking: baking, pancake, rolling pin, cake mold, scale, measuring\nGadgets & tools: gadget, strainer, press, tongs, slicer, sharpener, finger guard, frother, egg, steamer, washer, defrosting, patty, rice, dispenser\n\n[living-room]\nLighting: lamp, night light, lighting\nBlankets & cushions: blanket, throw, cushion\nWall art: wall art, wall hanging, tapestry, canvas, wall print, picture\nCurtains: curtain\nDecor & storage: diffuser, candle, basket, table runner, decor, storage\n\n[pet-supplies]\nGrooming: grooming, nail, bath, massage, brush, comb\nClothing & harnesses: clothing, sweater, vest, harness\nCarriers & travel: carrier, travel, car seat, seat belt, sling\nToys & scratchers: toy, scratch, tunnel\nBeds & care: bed mat, scooper, poop, bed\n\n[bedroom]\nLighting: lamp, night light, lighting\nStorage: storage, organizer, organiser, underbed, rack\nRugs: rug, bedside mat\nWall decor: wall hanging, tapestry\nBedding & pillows: blanket, throw, runner, pillow, cushion, mattress, bedding, eye mask", "info": "One block per category, headed by its handle in square brackets, for example [kitchen]. Under it, one chip per line: Chip name: word, word. A product goes under the first chip whose words appear in its name, type or tags; products that match none go under 'Other'. Delete a block to remove that category's chips. Bathroom uses its own sub-categories and chips above." },
    { "type": "textarea", "id": "more_groups", "label": "Extra category chips (one per line)", "default": "Towels: towel\nAccessories: accessor, dispenser, holder, soap, shower head, pillow, toothbrush\nRugs & covers: toilet, rug set, door mat\nArt & sets: wall art, canvas, bath set", "info": "Format: Chip name: word, word. A product goes under the first chip whose words appear in its name, type or tags. Products that match none go under 'Other'." }
  ]
}
{% endschema %}
