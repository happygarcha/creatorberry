{% render 'breadcrumbs' %}
<header class="page-head">
  <div>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="prose">{{ collection.description }}</div>{%- endif -%}
  </div>
  <div class="dw-coll-tools">
    <form class="dw-coll-search" role="search" action="{{ routes.search_url }}" method="get">
      <label class="sr-only" for="coll-q">Search in {{ collection.title | escape }}</label>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input id="coll-q" type="search" name="q" placeholder="Search in {{ collection.title | escape }}" autocomplete="off" data-coll-search>
      <input type="hidden" name="type" value="product">
    </form>
    <form class="sortbar" method="get" action="{{ collection.url }}">
      <label class="sr-only" for="sort_by">{{ 'collection.sort' | t }}</label>
      <select id="sort_by" name="sort_by" onchange="this.form.submit()">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
      <noscript><button class="btn" type="submit">{{ 'collection.sort' | t }}</button></noscript>
    </form>
  </div>
</header>

{%- paginate collection.products by section.settings.per_page -%}
  {%- if collection.products.size == 0 -%}
    <p class="empty-state">{{ 'collection.empty' | t }}</p>
  {%- else -%}
    <p class="dw-coll-none" data-coll-none hidden>No products here match <b data-coll-term></b>. <a data-coll-site href="{{ routes.search_url }}">Search the whole store instead</a></p>
    <div class="feed">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product, index: forloop.index0, eager: 2 %}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if paginate.pages > 1 -%}
    <nav class="pager" aria-label="{{ 'general.pagination' | t }}">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="cur" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
    </nav>
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [{ "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "default": 48, "label": "Products per page" }]
}
{% endschema %}
