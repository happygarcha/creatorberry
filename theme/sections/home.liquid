{%- comment -%}
  Drapewell homepage (bright and friendly redesign).
  Order: hero with product tiles, trust bar, shop by category, new arrivals, offer banner,
  product rows, intro text. Product data comes from the store; nothing here is hard-coded.
{%- endcomment -%}
{%- assign new_src = collections['new-arrivals'] -%}
{%- if new_src == blank or new_src.products_count == 0 -%}{%- assign new_src = collections.all -%}{%- endif -%}
{%- if new_src.handle == 'all' -%}{%- assign newest = new_src.products | sort: 'created_at' | reverse -%}{%- else -%}{%- assign newest = new_src.products -%}{%- endif -%}

{%- comment -%} ---------- HERO: big headline + a calm fan of product cards ---------- {%- endcomment -%}
{%- assign offer_col = collections['buy-2-save-10'] -%}
<section class="dw-hero" aria-labelledby="hero-h">
  <div class="dw-hero-top">
    <div class="dw-hero-main">
      <h1 id="hero-h">{{ 'home.intro_h' | t }}</h1>
    </div>
    <div class="dw-hero-side">
      <p class="dw-hero-sub">{{ 'home.discover_new' | t }}</p>
      <div class="dw-hero-cta">
        <a class="btn primary dw-btn-lg" href="#shop">{{ 'home.open' | t }}</a>
        {%- if offer_col != blank and offer_col.products_count > 0 -%}
          <a class="btn dw-btn-lg" href="{{ offer_col.url }}">Buy 2, save 10%</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}
    Reel selection (see the section settings in the theme editor):
    1. Products in the "Fresh this week" collection (a smart collection of products tagged "fresh").
    2. If fewer than the wanted number are there, it is topped up with the newest products,
       with at most N from the same product type so one bulk import cannot take over the reel.
    3. The heading says "Fresh this week" only when enough products are really tagged; otherwise "Just in".
  {%- endcomment -%}
  {%- assign reel_max = section.settings.reel_count -%}
  {%- assign reel_cap = section.settings.reel_per_type -%}
  {%- assign fresh_col = section.settings.reel_collection -%}
  {%- if fresh_col == blank -%}{%- assign fresh_col = collections['fresh-this-week'] -%}{%- endif -%}
  {%- assign picked = ',' -%}
  {%- assign picked_n = 0 -%}
  {%- assign fresh_n = 0 -%}
  {%- assign type_log = '' -%}
  {%- if fresh_col != blank -%}
    {%- for product in fresh_col.products -%}
      {%- if picked_n < reel_max and product.available and product.featured_image -%}
        {%- assign picked = picked | append: product.handle | append: ',' -%}
        {%- assign picked_n = picked_n | plus: 1 -%}
        {%- assign fresh_n = fresh_n | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if picked_n < reel_max -%}
    {%- for product in newest -%}
      {%- if picked_n < reel_max and product.available and product.featured_image -%}
        {%- assign hkey = ',' | append: product.handle | append: ',' -%}
        {%- unless picked contains hkey -%}
          {%- assign tkey = '|' | append: product.type | append: '|' -%}
          {%- assign without = type_log | remove: tkey -%}
          {%- assign used = type_log | size | minus: without.size | divided_by: tkey.size -%}
          {%- if used < reel_cap -%}
            {%- assign picked = picked | append: product.handle | append: ',' -%}
            {%- assign type_log = type_log | append: tkey -%}
            {%- assign picked_n = picked_n | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- assign picked_list = picked | split: ',' -%}
  {%- if fresh_n >= 4 -%}
    {%- assign reel_title = section.settings.reel_heading -%}
    {%- assign reel_link = fresh_col.url -%}
  {%- else -%}
    {%- assign reel_title = section.settings.reel_fallback_heading -%}
    {%- assign reel_link = new_src.url -%}
  {%- endif -%}

  <div class="dw-reel-wrap">
    <h2 id="reel-h" class="sr-only">{{ reel_title }}</h2>
    {%- assign stamps = 'NEW!,JUST IN,FRESH!,TOP PICK,LOVE IT,HOT!' | split: ',' -%}
    <div class="dw-reel" data-reel aria-labelledby="reel-h" style="--logo: url('{{ 'drapewell-logo.png' | asset_url }}')">
      <div class="dw-reel-stage">
        <div class="dw-reel-scene">
          <div class="dw-reel-ring" data-reel-ring role="list">
            <span class="dw-reel-rail" aria-hidden="true"></span>
            <span class="dw-reel-rail dw-reel-rail-top" aria-hidden="true"></span>
            <span class="dw-rod" data-at="60" aria-hidden="true"></span>
            <span class="dw-rod" data-at="180" aria-hidden="true"></span>
            <span class="dw-rod" data-at="300" aria-hidden="true"></span>
            <span class="dw-rod" data-at="0" aria-hidden="true"></span>
            <span class="dw-rod" data-at="120" aria-hidden="true"></span>
            <span class="dw-rod" data-at="240" aria-hidden="true"></span>
            {%- assign t = 0 -%}
            {%- for h in picked_list -%}
              {%- assign product = all_products[h] -%}
              {%- if h != blank and product != blank and product.featured_image -%}
                {%- assign lead = product.featured_image -%}
                {%- if lead.alt contains 'Safe use' and product.images.size > 1 -%}{%- assign lead = product.images[1] -%}{%- endif -%}
                {%- assign pk = t | modulo: 6 | plus: 1 -%}
                {%- assign sk = t | modulo: 6 -%}
                <a class="dw-reel-item" role="listitem" href="{{ product.url }}" draggable="false" style="--i: {{ t }}; --pc: var(--p{{ pk }})">
                  <span class="dw-hang" aria-hidden="true">
                    <i class="dw-cord"></i>
                    <span class="dw-reelbody">
                      {%- for z in (0..11) -%}<i class="rb-s" style="--a: {{ z | times: 30 }}"></i>{%- endfor -%}
                      <span class="rb-face rb-front"><span class="rb-disc"></span></span>
                      <span class="rb-face rb-back"><span class="rb-disc"></span></span>
                    </span>
                    <i class="dw-neck"></i>
                    <i class="dw-wire"></i>
                    <i class="dw-loop"></i>
                    <i class="dw-belt"></i>
                    <i class="dw-snap"></i>
                  </span>
                  <span class="dw-id">
                    <span class="dw-id-face dw-id-front">
                      <i class="dw-id-slot" aria-hidden="true"></i>
                      <span class="dw-id-photo">
                        {%- if t < 4 -%}
                          {{ lead | image_url: width: 400 | image_tag: loading: 'eager', widths: '200, 300, 400', sizes: '200px', alt: '', draggable: 'false' }}
                        {%- else -%}
                          {{ lead | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '200px', alt: '', draggable: 'false' }}
                        {%- endif -%}
                        <em class="dw-stamp" aria-hidden="true">{{ stamps[sk] }}</em>
                      </span>
                      <span class="dw-id-title">{{ product.title }}</span>
                      <span class="dw-id-meta"><span class="dw-id-price">{% render 'price', product: product %}</span></span>
                      <span class="dw-barcode" aria-hidden="true"></span>
                    </span>
                    <span class="dw-id-face dw-id-back" aria-hidden="true">
                      <img class="dw-id-back-logo" src="{{ 'drapewell-logo.png' | asset_url }}" alt="" width="360" height="360" loading="lazy" draggable="false">
                      <span class="dw-id-small">Ships to Canada &amp; US</span>
                    </span>
                  </span>
                </a>
                {%- assign t = t | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <p class="dw-reel-hint" aria-hidden="true"><span class="dw-reel-hint-i"></span>Hold &amp; pull a badge</p>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ---------- TRUST LINE ---------- {%- endcomment -%}
<ul class="dw-trust" aria-label="{{ section.settings.trust_label }}">
  {%- for i in (1..4) -%}
    {%- assign key = 'trust_' | append: i -%}
    {%- assign line = section.settings[key] -%}
    {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
  {%- endfor -%}
</ul>

{%- comment -%} The category chips now live in the site-wide menu under the header (snippets/category-chips.liquid). {%- endcomment -%}

{%- comment -%} ---------- NEW ARRIVALS ---------- {%- endcomment -%}
<section class="dw-section" id="shop" aria-labelledby="feed-h">
  <header class="dw-head">
    <h2 id="feed-h">{{ section.settings.feed_title }}</h2>
    <div class="dw-head-tools">
      <div class="sortbar">
        <label class="sr-only" for="home_sort">{{ 'collection.sort' | t }}</label>
        <select id="home_sort" data-home-sort>
          <option value="featured">{{ 'general.sort_featured' | t }}</option>
          <option value="new">{{ 'general.sort_new' | t }}</option>
          <option value="price_asc">{{ 'general.sort_price_asc' | t }}</option>
          <option value="price_desc">{{ 'general.sort_price_desc' | t }}</option>
          <option value="az">{{ 'general.sort_az' | t }}</option>
          <option value="za">{{ 'general.sort_za' | t }}</option>
        </select>
      </div>
    </div>
  </header>
  <div class="feed" id="feed">
    {%- for product in new_src.products limit: section.settings.count -%}
      {% render 'product-card', product: product, index: forloop.index0 %}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} ---------- OFFER BANNER ---------- {%- endcomment -%}
{%- if offer_col != blank and offer_col.products_count > 0 -%}
  <section class="dw-offer" aria-labelledby="offer-banner-h">
    <span class="dw-sticker" aria-hidden="true">10%<br>off</span>
    <div>
      <h2 id="offer-banner-h">Buy 2, save 10%</h2>
      <p>Add any 2 items from this offer to your cart and 10% comes off automatically at checkout. You can mix pet and bath items. Shipping is not discounted.</p>
    </div>
    <a class="btn dw-btn-lg" href="{{ offer_col.url }}">See all items in this offer</a>
  </section>
{%- endif -%}

{%- comment -%} ---------- PRODUCT ROWS ---------- {%- endcomment -%}
{% render 'home-row', handle: 'featured-picks', title: 'Featured picks', count: 5 %}
{%- if section.settings.show_rows -%}
  {% render 'home-row', handle: 'pet-supplies', title: 'Pet supplies', count: 4 %}
  {% render 'home-row', handle: 'seasonal', title: 'Seasonal picks', count: 4 %}
{%- endif -%}

{%- comment -%} ---------- ABOUT / SHIPPING ---------- {%- endcomment -%}
<section class="dw-about" aria-label="{{ shop.name }}">
  <p>{{ 'home.intro_p1' | t | replace: 'based in Surrey, British Columbia', 'based in Canada' }}</p>
  <p>{{ 'home.intro_p2' | t }}{% if shop.shipping_policy.url != blank %} <a href="{{ shop.shipping_policy.url }}">{{ 'home.intro_link' | t }}</a>.{% endif %}</p>
</section>

{% schema %}
{
  "name": "Drapewell home",
  "settings": [
    { "type": "text", "id": "feed_title", "label": "New arrivals title", "default": "New arrivals" },
    { "type": "text", "id": "rooms_title", "label": "Categories heading", "default": "Shop by category" },
    { "type": "text", "id": "trust_label", "label": "Trust bar label (screen readers)", "default": "Shipping and returns" },
    { "type": "text", "id": "trust_1", "label": "Trust line 1", "default": "Ships across Canada and the US" },
    { "type": "text", "id": "trust_2", "label": "Trust line 2", "default": "Tracked delivery" },
    { "type": "text", "id": "trust_3", "label": "Trust line 3", "default": "13-25 days to Canada, 10-20 days to the US" },
    { "type": "text", "id": "trust_4", "label": "Trust line 4", "default": "Damaged or wrong item? Contact us within 30 days" },
    { "type": "header", "content": "Hero reel (rotating badges)" },
    { "type": "text", "id": "reel_heading", "label": "Heading when products are tagged fresh", "default": "Fresh this week" },
    { "type": "text", "id": "reel_fallback_heading", "label": "Heading when it shows the newest products instead", "default": "Just in" },
    { "type": "collection", "id": "reel_collection", "label": "Collection to feature", "info": "Leave empty to use the 'Fresh this week' collection (products tagged fresh). Any collection works." },
    { "type": "range", "id": "reel_count", "min": 6, "max": 14, "step": 1, "default": 12, "label": "Number of badges", "info": "Phones show the first 8 so the badges stay readable." },
    { "type": "range", "id": "reel_per_type", "min": 1, "max": 4, "step": 1, "default": 2, "label": "Most products from one type when topping up with newest" },
    { "type": "header", "content": "Page" },
    { "type": "checkbox", "id": "show_rows", "label": "Show the Pet supplies and Seasonal rows", "default": true },
    { "type": "range", "id": "count", "min": 4, "max": 24, "step": 4, "default": 8, "label": "Products shown in New arrivals" }
  ],
  "presets": [{ "name": "Drapewell home" }]
}
{% endschema %}
