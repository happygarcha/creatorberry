 "shots": [
  {
   "id": "S1",
   "vo": [
    {
     "text": "\u0915\u094b\u0932\u0915\u093e\u0924\u093e \u092e\u0947\u0902 \u0905\u092c \u092e\u0947\u091f\u094d\u0930\u094b \u091f\u094d\u0930\u0947\u0928 \u0939\u0941\u0917\u0932\u0940 \u0928\u0926\u0940 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0938\u0947 \u0926\u094c\u0921\u093c\u0924\u0940 \u0939\u0948! \u092f\u0939 \u092d\u093e\u0930\u0924 \u0915\u0940 \u092a\u0939\u0932\u0940 \u0905\u0902\u0921\u0930\u0935\u093e\u091f\u0930 \u092e\u0947\u091f\u094d\u0930\u094b \u0939\u0948\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u090a\u092a\u0930 \u0928\u093e\u0935\u0947\u0902, \u0928\u0940\u091a\u0947 \u091f\u094d\u0930\u0947\u0928? \u0938\u091a \u092e\u0947\u0902?",
     "who": "GUY",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S2",
   "vo": [
    {
     "text": "\u092f\u0939 \u0908\u0938\u094d\u091f-\u0935\u0947\u0938\u094d\u091f \u092e\u0947\u091f\u094d\u0930\u094b \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0939\u0948, \u091c\u094b \u0939\u093e\u0935\u0921\u093c\u093e \u092e\u0948\u0926\u093e\u0928 \u0938\u0947 \u090f\u0938\u094d\u092a\u094d\u0932\u0947\u0928\u0947\u0921 \u0924\u0915 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u093e \u0909\u0926\u094d\u0918\u093e\u091f\u0928 \u091b\u0939 \u092e\u093e\u0930\u094d\u091a \u0926\u094b \u0939\u091c\u093c\u093e\u0930 \u091a\u094c\u092c\u0940\u0938 \u0915\u094b \u0939\u0941\u0906\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u0914\u0930 \u092a\u0902\u0926\u094d\u0930\u0939 \u092e\u093e\u0930\u094d\u091a \u0938\u0947 \u092f\u093e\u0924\u094d\u0930\u0940 \u0907\u0938\u092e\u0947\u0902 \u0938\u092b\u093c\u0930 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902!",
     "who": "FRIEND",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S3",
   "vo": [
    {
     "text": "\u0939\u0941\u0917\u0932\u0940 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0915\u0940 \u0938\u0941\u0930\u0902\u0917 \u0932\u0917\u092d\u0917 \u092a\u093e\u0901\u091a \u0938\u094c \u092c\u0940\u0938 \u092e\u0940\u091f\u0930 \u0932\u0902\u092c\u0940 \u0939\u0948, \u0914\u0930 \u091f\u094d\u0930\u0947\u0928 \u0907\u0938\u0947 \u0915\u0930\u0940\u092c \u092a\u0948\u0902\u0924\u093e\u0932\u0940\u0938 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092a\u093e\u0930 \u0915\u0930 \u0932\u0947\u0924\u0940 \u0939\u0948\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u092a\u0932\u0915 \u091d\u092a\u0915\u0924\u0947 \u0939\u0940!",
     "who": "GUY",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S4",
   "vo": [
    {
     "text": "\u0907\u0938\u0947 \u091f\u0928\u0932 \u092c\u094b\u0930\u093f\u0902\u0917 \u092e\u0936\u0940\u0928 \u0928\u0947 \u0916\u094b\u0926\u093e, \u091c\u094b \u092e\u093f\u091f\u094d\u091f\u0940 \u0915\u093e\u091f\u0924\u0947 \u0939\u0941\u090f \u0906\u0917\u0947 \u092c\u0922\u093c\u0924\u0940 \u0939\u0948 \u0914\u0930 \u092a\u0940\u091b\u0947 \u092e\u091c\u093c\u092c\u0942\u0924 \u0915\u0902\u0915\u094d\u0930\u0940\u091f \u0915\u0947 \u091b\u0932\u094d\u0932\u0947 \u091c\u094b\u0921\u093c\u0924\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0924\u093e\u0915\u093f \u0928\u0926\u0940 \u0915\u093e \u092a\u093e\u0928\u0940 \u0905\u0902\u0926\u0930 \u0928 \u0906\u090f\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u092a\u093e\u0928\u0940 \u0915\u093e \u0905\u0902\u0926\u0930 \u0906\u0928\u093e \u092e\u0928\u093e \u0939\u0948!",
     "who": "FRIEND",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S5",
   "vo": [
    {
     "text": "\u0939\u093e\u0935\u0921\u093c\u093e \u092e\u0948\u0926\u093e\u0928 \u0938\u094d\u091f\u0947\u0936\u0928 \u092d\u093e\u0930\u0924 \u0915\u093e \u0938\u092c\u0938\u0947 \u0917\u0939\u0930\u093e \u092e\u0947\u091f\u094d\u0930\u094b \u0938\u094d\u091f\u0947\u0936\u0928 \u0939\u0948, \u091c\u093c\u092e\u0940\u0928 \u0938\u0947 \u0932\u0917\u092d\u0917 \u0924\u0948\u0902\u0924\u0940\u0938 \u092e\u0940\u091f\u0930 \u0928\u0940\u091a\u0947, \u092f\u093e\u0928\u0940 \u0915\u0930\u0940\u092c \u0917\u094d\u092f\u093e\u0930\u0939 \u092e\u0902\u091c\u093c\u093f\u0932\u093e \u0907\u092e\u093e\u0930\u0924 \u091c\u093f\u0924\u0928\u093e\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u0907\u0924\u0928\u093e \u0928\u0940\u091a\u0947 \u0924\u094b \u0938\u0940\u0922\u093c\u093f\u092f\u093e\u0901 \u0928\u0939\u0940\u0902, \u090f\u0938\u094d\u0915\u0947\u0932\u0947\u091f\u0930 \u0939\u0940 \u091a\u093e\u0939\u093f\u090f!",
     "who": "BANKER",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S6",
   "vo": [
    {
     "text": "\u0924\u094b \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u0939\u0941\u0917\u0932\u0940 \u092a\u093e\u0930 \u0915\u0930\u0947\u0902, \u0924\u094b \u092f\u093e\u0926 \u0930\u0916\u093f\u090f, \u090a\u092a\u0930 \u0928\u093e\u0935\u0947\u0902 \u091a\u0932 \u0930\u0939\u0940 \u0939\u094b\u0902\u0917\u0940, \u0914\u0930 \u0928\u0940\u091a\u0947 \u0906\u092a\u0915\u0940 \u092e\u0947\u091f\u094d\u0930\u094b!",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u092e\u091b\u0932\u093f\u092f\u093e\u0901 \u092d\u0940 \u0926\u0947\u0916\u0924\u0940 \u0939\u094b\u0902\u0917\u0940!",
     "who": "GUY",
     "speed": 1.0
    },
    {
     "text": "\u092a\u0930 \u091f\u093f\u0915\u091f \u0924\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u092d\u0940 \u0932\u0947\u0928\u093e \u092a\u0921\u093c\u0947\u0917\u093e!",
     "who": "BANKER",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "ENDCARD",
   "vo": [
    {
     "text": "\u0932\u093e\u0907\u0915, \u0936\u0947\u092f\u0930 \u0914\u0930 \u0938\u092c\u094d\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0915\u0930\u0947\u0902!",
     "who": "N",
     "speed": 1.0,
     "pre": 0.3
    }
   ],
