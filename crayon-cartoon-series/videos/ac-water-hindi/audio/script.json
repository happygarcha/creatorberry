  {
   "id": "S1",
   "vo": [
    {
     "text": "\u0906\u092a\u0915\u0947 \u090f\u0938\u0940 \u0938\u0947 \u091f\u092a\u0915\u0924\u093e \u092a\u093e\u0928\u0940 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u093e\u092b\u093c \u0926\u093f\u0916\u0924\u093e \u0939\u0948\u0964 \u0932\u0947\u0915\u093f\u0928 \u0907\u0938\u0947 \u0915\u092d\u0940 \u092e\u0924 \u092a\u0940\u091c\u093f\u090f\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u092f\u0947 \u0924\u094b \u0938\u093e\u092b\u093c \u092a\u093e\u0928\u0940 \u0939\u0948!",
     "who": "GUY",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S2",
   "vo": [
    {
     "text": "\u0905\u0938\u0932 \u092e\u0947\u0902 \u0917\u0930\u094d\u092e, \u0928\u092e \u0939\u0935\u093e \u091c\u092c \u090f\u0938\u0940 \u0915\u0940 \u0920\u0902\u0921\u0940 \u0915\u0949\u0907\u0932 \u0938\u0947 \u091f\u0915\u0930\u093e\u0924\u0940 \u0939\u0948, \u0924\u094b \u092d\u093e\u092a \u092a\u093e\u0928\u0940 \u0915\u0940 \u092c\u0942\u0902\u0926\u0947\u0902 \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0915\u0902\u0921\u0947\u0902\u0938\u0947\u0936\u0928 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u091c\u0948\u0938\u0947 \u0920\u0902\u0921\u0947 \u0917\u093f\u0932\u093e\u0938 \u0915\u0947 \u092c\u093e\u0939\u0930!",
     "who": "FRIEND",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S3",
   "vo": [
    {
     "text": "\u090f\u0938\u0940 \u0939\u0935\u093e \u0915\u0940 \u0928\u092e\u0940 \u092d\u0940 \u0916\u0940\u0902\u091a \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0940\u0932\u093f\u090f \u0915\u092e\u0930\u093e \u0938\u0942\u0916\u093e \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948, \u0914\u0930 \u0906\u0901\u0916\u0947\u0902, \u0924\u094d\u0935\u091a\u093e \u0914\u0930 \u0917\u0932\u093e \u092a\u0930\u0947\u0936\u093e\u0928 \u0939\u094b\u0928\u0947 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964",
     "who": "N",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S4",
   "vo": [
    {
     "text": "\u0916\u093f\u0921\u093c\u0915\u093f\u092f\u093e\u0901 \u092c\u0902\u0926 \u0939\u094b\u0902, \u0924\u094b \u090f\u0938\u0940 \u0915\u092e\u0930\u0947 \u0915\u0940 \u0935\u0939\u0940 \u0939\u0935\u093e \u092c\u093e\u0930-\u092c\u093e\u0930 \u0918\u0941\u092e\u093e\u0924\u093e \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0915\u093e\u0930\u094d\u092c\u0928 \u0921\u093e\u0907\u0911\u0915\u094d\u0938\u093e\u0907\u0921 \u092c\u0922\u093c\u0928\u0947 \u0932\u0917\u0924\u0940 \u0939\u0948\u0964 \u092c\u0940\u091a-\u092c\u0940\u091a \u092e\u0947\u0902 \u0924\u093e\u091c\u093c\u0940 \u0939\u0935\u093e \u091c\u093c\u0930\u0942\u0930 \u0906\u0928\u0947 \u0926\u0940\u091c\u093f\u090f\u0964",
     "who": "N",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S5",
   "vo": [
    {
     "text": "\u092f\u0939 \u092a\u093e\u0928\u0940 \u0915\u0949\u0907\u0932, \u092a\u0948\u0928 \u0914\u0930 \u092a\u093e\u0907\u092a \u0938\u0947 \u0939\u094b\u0915\u0930 \u0928\u093f\u0915\u0932\u0924\u093e \u0939\u0948\u0964 \u0930\u093e\u0938\u094d\u0924\u0947 \u092e\u0947\u0902 \u0907\u0938\u092e\u0947\u0902 \u0915\u0940\u091f\u093e\u0923\u0941 \u0914\u0930 \u0927\u093e\u0924\u0941\u090f\u0901 \u0906 \u0938\u0915\u0924\u0940 \u0939\u0948\u0902, \u0915\u092d\u0940-\u0915\u092d\u0940 \u0932\u0947\u091c\u093f\u092f\u094b\u0928\u0947\u092f\u0930\u094d\u0938 \u091c\u0948\u0938\u0947 \u0916\u093c\u0924\u0930\u0928\u093e\u0915 \u092c\u0948\u0915\u094d\u091f\u0940\u0930\u093f\u092f\u093e \u092d\u0940\u0964 \u0907\u0938\u0932\u093f\u090f \u0907\u0938\u0947 \u092e\u0924 \u092a\u0940\u091c\u093f\u090f\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u0924\u094b \u092a\u094c\u0927\u094b\u0902 \u092e\u0947\u0902 \u0921\u093e\u0932 \u0926\u094b!",
     "who": "FRIEND",
     "speed": 1.0
    }
   ],
   "min": 6.0,
   "tail": 0.3
  },
  {
   "id": "S6",
   "vo": [
    {
     "text": "\u092f\u093e\u0926 \u0930\u0916\u093f\u090f, \u090f\u0938\u0940 \u0915\u093e \u092a\u093e\u0928\u0940 \u0928\u093e\u0932\u0940 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u092a\u0940\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902\u0964",
     "who": "N",
     "speed": 1.0
    },
    {
     "text": "\u092a\u0930 \u092f\u0947 \u0924\u094b \u092e\u0941\u092b\u093c\u094d\u0924 \u0939\u0948!",
     "who": "BANKER",
     "speed": 1.0
    },
    {
     "text": "\u0914\u0930 \u092e\u0941\u092b\u093c\u094d\u0924 \u092e\u0947\u0902 \u0915\u0940\u091f\u093e\u0923\u0941 \u092d\u0940!",
     "who": "GUY",
