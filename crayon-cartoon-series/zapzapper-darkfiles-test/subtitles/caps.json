[
 {
  "t0": 0.45,
  "t1": 3.929,
  "text": "THE ABANDONED MILLER HOUSE HAD STOOD EMPTY FOR YEARS.",
  "label": "",
  "col": "#fff",
  "who": "NARRATOR"
 },
 {
  "t0": 4.45,
  "t1": 7.286,
  "text": "BUT SOMETHING IN ITS BASEMENT DIDN'T BELONG.",
  "label": "",
  "col": "#fff",
  "who": "NARRATOR"
 },
 {
  "t0": 11.25,
  "t1": 14.468,
  "text": "\"WHY WOULD SOMEONE BOLT AN EMPTY SHELF TO THE FLOOR?\"",
  "label": "REED:",
  "col": "#F2C14E",
  "who": "REED"
 },
 {
  "t0": 17.25,
  "t1": 18.947,
  "text": "\"DANIEL... LOOK AT THIS.\"",
  "label": "MORGAN:",
  "col": "#7FC8F8",
  "who": "MORGAN"
 },
 {
  "t0": 23.55,
  "t1": 29.011,
  "text": "BEHIND THE SHELVING UNIT WAS A DOOR THAT APPEARED ON NONE OF THE SURVIVING FLOOR PLANS.",
  "label": "",
  "col": "#fff",
  "who": "NARRATOR"
 },
 {
  "t0": 36.35,
  "t1": 37.91,
  "text": "\"THERE'S ANOTHER ROOM.\"",
  "label": "MORGAN:",
  "col": "#7FC8F8",
  "who": "MORGAN"
 },
 {
  "t0": 45.35,
  "t1": 47.772,
  "text": "\"SOMEONE'S BEEN USING THIS PLACE.\"",
  "label": "REED:",
  "col": "#F2C14E",
  "who": "REED"
 },
 {
  "t0": 47.85,
  "t1": 50.89,
  "text": "AND ON THE DESK, THEY FOUND SOMETHING UNEXPECTED.",
  "label": "",
  "col": "#fff",
  "who": "NARRATOR"
 },
 {
  "t0": 54.95,
  "t1": 56.632,
  "text": "\"MOM... IT'S ME.\"",
  "label": "GIRL'S VOICE:",
  "col": "#F29BB0",
  "who": "LILY"
 }
]